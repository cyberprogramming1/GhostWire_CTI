# GhostWire CTI v6 — API Keys
# Copy this to .streamlit/secrets.toml OR create .env file

# Required for full functionality
VIRUSTOTAL_API_KEY = "your_virustotal_key_here"
ABUSEIPDB_API_KEY  = "your_abuseipdb_key_here"

# Optional — enhances IP intelligence
SHODAN_API_KEY     = "your_shodan_key_here"      # https://account.shodan.io
GREYNOISE_API_KEY  = "your_greynoise_key_here"   # https://www.greynoise.io/signup

